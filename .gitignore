node_modules/
.env
.env.local
*.log
scratch/

# Runtime data: customer conversations, payment accounts, users, usage and
# campaign state are created on first boot and must never be committed.
# The product catalog is the one deliberate exception (tracked below).
data/*
!data/tools.json

# Seeded defaults: only the product catalog and non-sensitive app config are
# tracked. Anything holding real customer, payment or credential data is not.
data_defaults/customers.json
data_defaults/settings.json
data_defaults/users.json
data_defaults/audit_logs.json
data_defaults/usage.json
data_defaults/campaign.json
data_defaults/deepgram_accounts.json
data_defaults/github_config.json
